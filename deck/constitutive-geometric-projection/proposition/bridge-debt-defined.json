  "statements": [
    {
      "id": "62722ae7-68e9-4365-9c54-0def6e7bdacd",
      "text": "A theory is bridge-debted when it requires two domains to be distinct, asks for a relation spanning them, and provides no witness for their separation that is independent of the bridge it then demands.",
